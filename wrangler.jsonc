{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scitani-dopravy-candidate-v160",
  "account_id": "4d57fbfa84fddbd6f7514a10794da146",
  "main": "cloudflare/worker-release-1.6.0.mjs",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "workers_dev": true,
  "build": { "command": "node cloudflare/prepare-deploy.mjs" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "scitani-dopravy-candidate-v160",
    "database_id": "CONFIGURE_ISOLATED_CANDIDATE_D1_DATABASE_ID"
  }],
  "assets": {
    "directory": ".cloudflare-assets",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
